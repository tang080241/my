        const APPS = [
            { id: 'weather', n: '天气', i: '🌤️', c: '#74b9ff' }, { id: 'clock', n: '时钟', i: '⏰', c: '#1e272e' },
            { id: 'notes', n: '记事本', i: '📝', c: '#ffc048' }, { id: 'contacts', n: '通讯录', i: '📇', c: '#00b894' },
            { id: 'calendar', n: '日历', i: '📅', c: '#fd79a8' }, { id: 'music', n: '音乐', i: '🎵', c: '#ff6b6b' },
            { id: 'photos', n: '相册', i: '🖼️', c: '#a29bfe' }, { id: 'messages', n: '信息', i: '💬', c: '#00cec9' },
            { id: 'game', n: '打地鼠', i: '🔨', c: '#e17055' }, { id: 'wallpaper', n: '壁纸', i: '🎨', c: '#6c5ce7' },
