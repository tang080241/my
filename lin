        const WALLPAPERS = [
            { n: '星空', c: 'linear-gradient(180deg, #1a1a3e 0%, #0f0f2a 50%, #162040 100%)' },
            { n: '日落', c: 'linear-gradient(180deg, #2d1b2e 0%, #4a1a2e 50%, #1a0a1a 100%)' },
            { n: '海洋', c: 'linear-gradient(180deg, #0a2a3e 0%, #0a3a5e 50%, #061a2e 100%)' },
            { n: '森林', c: 'linear-gradient(180deg, #0a2a1a 0%, #0a3a2a 50%, #051a10 100%)' },
            { n: '暗紫', c: 'linear-gradient(180deg, #1a0a2e 0%, #2a0a4e 50%, #100520 100%)' },
            { n: '经典', c: 'linear-gradient(180deg, #111 0%, #0a0a0a 50%, #050505 100%)' },
