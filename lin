        const DOCK = [
            { id: 'notes', n: '记事本', i: '📝', c: '#ffc048' }, { id: 'messages', n: '信息', i: '💬', c: '#00cec9' },
            { id: 'music', n: '音乐', i: '🎵', c: '#ff6b6b' }, { id: 'wallpaper', n: '壁纸', i: '🎨', c: '#6c5ce7' },
        ];

        // ===== 数据加载 =====
        function loadData() {
            notes = JSON.parse(localStorage.phone_notes || '[]');
            contacts = JSON.parse(localStorage.phone_contacts || '[]');
            events = JSON.parse(localStorage.phone_events || '{}');
            msgs = JSON.parse(localStorage.phone_msgs || '[]');
            wpIdx = +localStorage.phone_wp || 0;
            if (!contacts.length) {
                contacts = [{ n: '妈妈', p: '138****1234', a: '👩', c: '#fd79a8' }, { n: '爸爸', p: '139****5678', a: '👨',
                    c: '#74b9ff' }, { n: '小明', p: '150****9012', a: '🧑', c: '#00b894' }, { n: '小红', p: '186****3456',
                    a: '👧', c: '#ffc048' }
                ];
                save('contacts', contacts);
            }
            if (!msgs.length) {
                msgs = [{ t: '周末一起出去玩吧！', s: false, time: '10:30' }, { t: '好的！去哪里？', s: true, time: '10:32' }, { t: '去公园怎么样？天气很好☀️',
                    s: false, time: '10:33' }];
                save('msgs', msgs);
            }
            document.getElementById('screen').style.background = WALLPAPERS[wpIdx].c;
            const n = new Date();
            calY = n.getFullYear();
            calM = n.getMonth();
        }

        function save(k, v) { localStorage['phone_' + k] = JSON.stringify(v); }

        function applyWP() { document.getElementById('screen').style.background = WALLPAPERS[wpIdx].c; }

        // ===== 渲染 =====
        function renderApps() {
            const g = document.getElementById('appsGrid');
            const nb = notes.length;
            const mb = msgs.filter(m => !m.s).length;
            g.innerHTML = APPS.map(a => {
                let b = '';
                if (a.id === 'notes' && nb) b = `<span class="badge">${nb}</span>`;
                if (a.id === 'messages' && mb) b = `<span class="badge">${mb}</span>`;
                return `<div class="app-item" onclick="openApp('${a.id}')"><div class="app-icon" style="background:${a.c}">${a.i}${b}</div><span class="app-name">${a.n}</span></div>`;
            }).join('');
            document.getElementById('dockBar').innerHTML = DOCK.map(a =>
                `<div class="app-item" onclick="openApp('${a.id}')"><div class="app-icon" style="background:${a.c}">${a.i}</div><span class="app-name">${a.n}</span></div>`
                ).join('');
        }

        function updateTime() { document.getElementById('stime').textContent = new Date().getHours().toString().padStart(2,
                '0') + ':' + new Date().getMinutes().toString().padStart(2, '0'); }

        // ===== 应用切换 =====
        function openApp(id) {
            curApp = id;
            document.getElementById('home').style.display = 'none';
            document.querySelectorAll('.app-screen').forEach(s => s.classList.remove('active'));
            const el = document.getElementById('app' + id.charAt(0).toUpperCase() + id.slice(1));
            if (!el) return;
            el.classList.add('active');
            if (id === 'clock') startClock();
            if (id === 'music') updateMusic();
            if (id === 'notes') renderNotes();
            if (id === 'contacts') renderContacts();
            if (id === 'calendar') renderCal();
            if (id === 'photos') renderPhotos();
            if (id === 'messages') renderMsgs();
            if (id === 'wallpaper') renderWP();
            if (id === 'game') buildGame();
        }

        function goHome() {
            curApp = 'home';
            document.getElementById('home').style.display = '';
            document.querySelectorAll('.app-screen').forEach(s => s.classList.remove('active'));
            clearTimers();
            renderApps();
        }

        function clearTimers() {
            [clockT, swT, musicInt, gameT, moleInt].forEach(t => { if (t) clearInterval(t); });
            swRunning = false;
            swSec = 0;
            musicPlaying = false;
            gameOn = false;
        }

        // ===== 弹窗 =====
        function showModal(t, m) { document.getElementById('mtitle').textContent = t;
            document.getElementById('mmsg').innerHTML = m;
            document.getElementById('modal').classList.add('show'); }

        function closeModal() { document.getElementById('modal').classList.remove('show'); }
        document.getElementById('modal').onclick = function(e) { if (e.target === this) closeModal(); };
        document.onkeydown = function(e) { if (e.key === 'Escape') curApp === 'home' ? closeModal() : goHome(); };

